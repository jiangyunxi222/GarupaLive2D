      "url": "https://bestdori.com/assets/jp/sound/voice/scenario/bandstory81_rip/band5-001-019.mp3",
      "sha256": "c8cd5007b37820797a5746075a6b70421bb12d8210fc1348326f4b4dc28413e3",
      "nativeSha256": "c8cd5007b37820797a5746075a6b70421bb12d8210fc1348326f4b4dc28413e3",
      "bytes": 70452,
      "seconds": 6.208,
      "path": "assets/voices/source_band5-001-019.mp3",
      "subtitle": "今夜，从解开火与黑暗之封印的黑暗之地，\n速速出现在我面前吧……！"
    },
    {
      "slug": "ako",
      "provider": "Bestdori",
      "characterId": 24,
      "speaker": 24,
      "text": "……啊！正好！久等了，燐燐。\n燐燐想出来的台词果然超级帅气呢",
      "cue": "band5-001-020",
      "storyId": "81",
      "scenario": "band5-001",
      "scenarioUrl": "https://bestdori.com/assets/jp/scenario/band/005_rip/Scenarioband5-001.asset",
      "subtitleUrl": "https://bestdori.com/assets/cn/scenario/band/005_rip/Scenarioband5-001.asset",
      "url": "https://bestdori.com/assets/jp/sound/voice/scenario/bandstory81_rip/band5-001-020.mp3",
      "sha256": "c0143305374c40313e59abf91348facfb9f57bc6adfc9e76c52e3a1098e29f8b",
      "nativeSha256": "c0143305374c40313e59abf91348facfb9f57bc6adfc9e76c52e3a1098e29f8b",
      "bytes": 84240,
      "seconds": 8.642,
      "path": "assets/voices/source_band5-001-020.mp3",
      "subtitle": "……啊！正好！久等了，燐燐。\n燐燐想出来的台词果然超级帅气呢"
    },
    {
      "slug": "ako",
      "provider": "Bestdori",
      "characterId": 24,
      "speaker": 24,
      "text": "欸嘿嘿。谢谢夸奖。那就走吧！\n……哎呀！",
      "cue": "band5-001-022",
      "storyId": "81",
      "scenario": "band5-001",
      "scenarioUrl": "https://bestdori.com/assets/jp/scenario/band/005_rip/Scenarioband5-001.asset",
