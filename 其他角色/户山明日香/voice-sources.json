      "sha256": "3e71ad31ba7ffdbb3d6180b7f1cb91f6373e09ebafc03fc5e986ac67d132260f",
      "bytes": 59976,
      "path": "assets/voices/bestdori_event217-04-045.mp3"
    },
    {
      "characterId": 214,
      "speaker": "明日香",
      "speakerCn": "明日香",
      "text": "辛苦了。\n第一次参加学生会，感觉怎么样？",
      "voiceId": "event217-19-003",
      "storyId": "main70",
      "chapterTitle": "主线第 70 话",
      "scenarioUrl": "https://bestdori.com/assets/jp/scenario/main_rip/Scenariomain070.asset",
      "subtitleUrl": "https://bestdori.com/assets/cn/scenario/main_rip/Scenariomain070.asset",
      "url": "https://bestdori.com/assets/jp/sound/voice/scenario/mainstory70_rip/event217-19-003.mp3",
      "sha256": "0959093e52e1381523418be3e191d893985c8b14627285ca061409b2cf6b39ad",
      "bytes": 32832,
      "path": "assets/voices/bestdori_event217-19-003.mp3"
    },
    {
      "characterId": 214,
      "speaker": "明日香",
      "speakerCn": "明日香",
      "text": "加油啊，六花。我们也会支持你的",
      "voiceId": "event217-19-010",
      "storyId": "main70",
      "chapterTitle": "主线第 70 话",
      "scenarioUrl": "https://bestdori.com/assets/jp/scenario/main_rip/Scenariomain070.asset",
      "subtitleUrl": "https://bestdori.com/assets/cn/scenario/main_rip/Scenariomain070.asset",
      "url": "https://bestdori.com/assets/jp/sound/voice/scenario/mainstory70_rip/event217-19-010.mp3",
      "sha256": "97223ab3a7646b2f3ebabb48c6bea8be157e3e0f194d4b334631a73b72eeb2e5",
      "bytes": 31932,
      "path": "assets/voices/bestdori_event217-19-010.mp3"
    },
    {
      "characterId": 214,
      "speaker": "明日香",
      "speakerCn": "明日香",
      "text": "亚子只是想吃甜食而已吧。\n而且，还得听听小真白的意见……\n顺便问一下，六花有想去的店吗？",
      "voiceId": "event217-19-013",
      "storyId": "main70",
      "chapterTitle": "主线第 70 话",
      "scenarioUrl": "https://bestdori.com/assets/jp/scenario/main_rip/Scenariomain070.asset",
      "subtitleUrl": "https://bestdori.com/assets/cn/scenario/main_rip/Scenariomain070.asset",
      "url": "https://bestdori.com/assets/jp/sound/voice/scenario/mainstory70_rip/event217-19-013.mp3",
      "sha256": "158bdbacd71275b04082fa49aaaf502c2c6636a172661c706814965ca9f636e5",
      "bytes": 99828,
      "path": "assets/voices/bestdori_event217-19-013.mp3"
    },
    {
      "characterId": 214,
      "speaker": "明日香",
      "speakerCn": "明日香",
      "text": "啊……我是户山明日香。请多指教。\n你是RAS的鼓手吧……我经常听亚子和六花提起你",
      "voiceId": "event217-19-021",
      "storyId": "main70",
      "chapterTitle": "主线第 70 话",
      "scenarioUrl": "https://bestdori.com/assets/jp/scenario/main_rip/Scenariomain070.asset",
      "subtitleUrl": "https://bestdori.com/assets/cn/scenario/main_rip/Scenariomain070.asset",
      "url": "https://bestdori.com/assets/jp/sound/voice/scenario/mainstory70_rip/event217-19-021.mp3",
      "sha256": "dc3bb0125354d4ffc6677862c170d77ac39d3b786f5b1714424f046a90d48df4",
      "bytes": 90468,
      "path": "assets/voices/bestdori_event217-19-021.mp3"
    },
    {
      "characterId": 214,
      "speaker": "明日香",
      "speakerCn": "明日香",
      "text": "不过，见到你本人后……我感觉你很有魄力呢。\n我还以为校门口有不良少女，\n都被吓到了……",
      "voiceId": "event217-19-022",
      "storyId": "main70",
      "chapterTitle": "主线第 70 话",
      "scenarioUrl": "https://bestdori.com/assets/jp/scenario/main_rip/Scenariomain070.asset",
      "subtitleUrl": "https://bestdori.com/assets/cn/scenario/main_rip/Scenariomain070.asset",
      "url": "https://bestdori.com/assets/jp/sound/voice/scenario/mainstory70_rip/event217-19-022.mp3",
      "sha256": "cfec47eb8158be8283664f0787b6c56b94359d2f82a35e428482c65519c853d8",
      "bytes": 92196,
      "path": "assets/voices/bestdori_event217-19-022.mp3"
    },
    {
      "characterId": 214,
      "speaker": "明日香",
      "speakerCn": "明日香",
      "text": "我也要请你多多指教，小真白。\n虽然我见过舞台上的你，但直接对话还是……",
      "voiceId": "event217-19-035",
      "storyId": "main70",
      "chapterTitle": "主线第 70 话",
      "scenarioUrl": "https://bestdori.com/assets/jp/scenario/main_rip/Scenariomain070.asset",
      "subtitleUrl": "https://bestdori.com/assets/cn/scenario/main_rip/Scenariomain070.asset",
      "url": "https://bestdori.com/assets/jp/sound/voice/scenario/mainstory70_rip/event217-19-035.mp3",
      "sha256": "0bb2d135af0102082662ae3088530fd68b9fadcc4edd7c0bcdd48355af1653da",
      "bytes": 64152,
      "path": "assets/voices/bestdori_event217-19-035.mp3"
    },
    {
      "characterId": 214,
      "speaker": "明日香",
      "speakerCn": "明日香",
      "text": "啊，小真白，你先别动。\n头上有樱花花瓣",
      "voiceId": "event217-19-037",
      "storyId": "main70",
      "chapterTitle": "主线第 70 话",
      "scenarioUrl": "https://bestdori.com/assets/jp/scenario/main_rip/Scenariomain070.asset",
