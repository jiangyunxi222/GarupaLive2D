    {
      "characterId": 214,
      "speaker": "明日香",
      "speakerCn": "明日香",
      "text": "叫我明日香就好了哦，小真白",
      "voiceId": "event217-19-041",
      "storyId": "main70",
      "chapterTitle": "主线第 70 话",
      "scenarioUrl": "https://bestdori.com/assets/jp/scenario/main_rip/Scenariomain070.asset",
      "subtitleUrl": "https://bestdori.com/assets/cn/scenario/main_rip/Scenariomain070.asset",
