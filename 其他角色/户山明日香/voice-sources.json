      "sha256": "8f1f8e22f1603a6632aece5141a4549bdb68eff90857a5bad367fb96bdef5836",
      "bytes": 51696,
      "path": "assets/voices/bestdori_event217-19-037.mp3"
    },
    {
      "characterId": 214,
      "speaker": "明日香",
      "speakerCn": "明日香",
      "text": "明日香",
      "voiceId": "event217-19-039",
      "storyId": "main70",
      "chapterTitle": "主线第 70 话",
