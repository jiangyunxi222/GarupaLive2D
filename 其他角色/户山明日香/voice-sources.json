    {
      "characterId": 214,
      "speaker": "明日香",
      "speakerCn": "明日香",
      "text": "亚子、六花，我想再郑重地说一遍……\n作为2-A的同班同学，今年也请多多关照哦",
      "voiceId": "event217-04-045",
      "storyId": "main55",
      "chapterTitle": "主线第 55 话",
