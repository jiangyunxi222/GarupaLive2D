      "evidence": "https://raw.githubusercontent.com/ci-ke/story-assets-bdon/3ba846a1360a82782ff6a30dd64d9744f4886b6a/assets/bdon-en-assets/Adv/Episode/adv_script_mujica_002_1_14/adv_script_mujica_002_1_14-Episode/adv_script_mujica_002_1_14-Episode.json.br",
      "discussion": "",
      "pcm_sha256": "a3984a17add33fd4b9527528bedc8c47df379b9b587f151a3cbb9d756bfa4392",
      "path": "assets/voices/curated_adv_voice_mujica_002_1_14_004.wav",
      "subtitle": "我们今天也约好了，工作结束后一起去吃饭。\n不介意的话，小初也一起——",
      "personality": null,
      "source_sha256": "0217cbce897896f80404c8434ba9da195dab5366cabe0d1929f7c6202f6ae150",
      "subtitleSource": "https://raw.githubusercontent.com/ci-ke/story-assets-bdon/3ba846a1360a82782ff6a30dd64d9744f4886b6a/assets/bdon-en-assets/Adv/Episode/adv_script_mujica_002_1_14/adv_script_mujica_002_1_14-Text/adv_script_mujica_002_1_14-Text.json.br"
    },
    {
