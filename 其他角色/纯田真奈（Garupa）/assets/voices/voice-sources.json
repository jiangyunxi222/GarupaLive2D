      "evidence": "https://raw.githubusercontent.com/ci-ke/story-assets-bdon/3ba846a1360a82782ff6a30dd64d9744f4886b6a/assets/bdon-en-assets/Adv/Episode/adv_script_mujica_002_1_03/adv_script_mujica_002_1_03-Episode/adv_script_mujica_002_1_03-Episode.json.br",
      "discussion": "",
      "pcm_sha256": "af1f743e3d7386eba23ff9862fe094a6388878ef7b6b1db5baf2ed9fec3f0339",
      "path": "assets/voices/curated_adv_voice_mujica_002_1_03_200.wav",
      "subtitle": "给，分一半甜甜圈给累坏的小初。\nsumimi可是二人一体的哦？",
      "personality": null,
      "source_sha256": "8b38f0a14631c1c90413a8cb67392145a6056655f0aae564d96d283fff921eef",
      "subtitleSource": "https://raw.githubusercontent.com/ci-ke/story-assets-bdon/3ba846a1360a82782ff6a30dd64d9744f4886b6a/assets/bdon-en-assets/Adv/Episode/adv_script_mujica_002_1_03/adv_script_mujica_002_1_03-Text/adv_script_mujica_002_1_03-Text.json.br"
