      "path": "assets/voices/bestdori_event235-15-018.mp3"
    },
    {
      "characterId": 339,
      "speaker": "海鈴",
      "speakerCn": "海铃",
      "text": "『Notria』『Jasmy＆Husky』\n『Disruption』",
